{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "mabel-room-103",
  "workers_dev": true,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mabel-room-103"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    { "pattern": "mabelroom103.rs", "custom_domain": true },
    { "pattern": "www.mabelroom103.rs", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
